# Required by the backend API and admin bootstrap command.
MONGODB_URI=

# Optional school display settings.
SCHOOL_NAME=JABANA BRIGHT ANGELS PRE AND PRIMARY SCHOOL
ACADEMIC_YEAR=

# Set this in Vercel only when using a custom domain.
FRONTEND_URL=

# Optional SMTP settings for staff password-recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional Google OAuth settings for the school's Gmail mailbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Local one-time administrator bootstrap only. Do not configure these in Vercel.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
